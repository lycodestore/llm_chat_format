padding: 4px;\n121:       transition: color 0.2s;\n122:     }\n123:     .todo-item .delete-btn:hover { color: #e74c3c; }\n124:     .footer {\n125:       display: flex;\n126:       justify-content: space-between;\n127:       align-items: center;\n128:       margin-top: 20px;\n129:       padding-top: 16px;\n130:       border-top: 1px solid #f0f0f0;\n131:       font-size: 13px;\n132:       color: #999;\n133:     }\n134:     .footer button {\n135:       background: none;\n136:       border: none;\n137:       color: #e74c3c;\n138:       cursor: pointer;\n139:       font-size: 13px;\n140:       padding: 4px 8px;\n141:       border-radius: 6px;\n142:       transition: background 0.2s;\n143:     }\n144:     .footer button:hover { background: #fdf0ef; }\n145:     .empty-state {\n146:       text-align: center;\n147:       padding: 40px 0;\n148:       color: #bbb;\n149:     }\n150:     .empty-state .icon { font-size: 48px; margin-bottom: 12px; }\n151:   </style>\n152: </head>\n153: <body>\n154:   <div class=\"container\">\n155:     <h1>Todo <span id=\"count\">0</span></h1>\n156: \n157:     <div class=\"input-row\">\n158:       <input id=\"input\" type=\"text\" placeholder=\"Add a new task...\" autofocus>\n159:       <button id=\"addBtn\">Add</button>\n160:     </div>\n161: \n162:     <div class=\"filters\">\n163:       <button class=\"active\" data-filter=\"all\">All</button>\n164:       <button data-filter=\"active\">Active</button>\n165:       <button data-filter=\"completed\">Completed</button>\n166:     </div>\n167: \n168:     <ul class=\"todo-list\" id=\"todoList\"></ul>\n169: \n170:     <div class=\"footer\">\n171:       <span id=\"remainCount\">0 items left</span>\n172:       <button id=\"clearBtn\">Clear completed</button>\n173:     </div>\n174:   </div>\n175: \n176:   <script>\n177:     const STORAGE_KEY = 'todos'\n178: \n179:     let todos = JSON.parse(localStorage.getItem(STORAGE_KEY)) || []\n180:     let filter = 'all'\n181: \n182:     const $ = id => document.getElementById(id)\n183:     const input = $('input')\n184:     const list = $('todoList')\n185:     const count = $('count')\n186:     const remain = $('remainCount')\n187: \n188:     function save() {\n189:       localStorage.setItem(STORAGE_KEY, JSON.stringify(todos))\n190:     }\n191: \n192:     function render() {\n193:       const filtered = todos.filter(t => {\n194:         if (filter === 'active') return !t.done\n195:         if (filter === 'completed') return t.done\n196:         return true\n197:       })\n198: \n199:       if (filtered.length === 0) {\n200:         list.innerHTML = `<div class=\"empty-state\"><div class=\"icon\">📋</div>No tasks ${filter === 'all' ? '' : filter}</div>`\n201:       } else {\n202:         list.innerHTML = filtered.map(t => `\n203:           <li class=\"todo-item\" data-id=\"${t.id}\">\n204:             <div class=\"checkbox ${t.done ? 'checked' : ''}\" onclick=\"toggle('${t.id}')\"></div>\n205:             <span class=\"text ${t.done ? 'completed' : ''}\" ondblclick=\"edit('${t.id}')\">${escapeHtml(t.text)}</span>\n206:             <button class=\"delete-btn\" onclick=\"remove('${t.id}')\">✕</button>\n207:           </li>\n208:         `).join('')\n209:       }\n210: \n211:       const active = todos.filter(t => !t.done).length\n212:       count.textContent = todos.length\n213:       remain.textContent = `${active} item${active !== 1 ? 's' : ''} left`\n214: \n215:       document.querySelectorAll('.filters button').forEach(btn => {\n216:         btn.classList.toggle('active', btn.dataset.filter === filter)\n217:       })\n218:     }\n219: \n220:     function escapeHtml(text) {\n221:       const div = document.createElement('div')\n222:       div.textContent = text\n223:       return div.innerHTML\n224:     }\n225: \n226:     function add() {\n227:       const text = input.value.trim()\n228:       if (!text) return\n229:       todos.push({ id: Date.now().toString(), text, done: false })\n230:       save(); render(); input.value = ''; input.focus()\n231:     }\n232: \n233:     function toggle(id) {\n234:       const t = todos.find(t => t.id === id)\n235:       if (t) { t.done = !t.done; save(); render() }\n236:     }\n237: \n238:     function remove(id) {\n239:       todos = todos.filter(t => t.id !== id)\n240:       save(); render(); input.focus()\n241:     }\n242: \n243:     function edit(id) {\n244:       const t = todos.find(t => t.id === id)\n245:       if (!t || t.done) return\n246:       const newText = prompt('Edit task:', t.text)\n247:       if (newText && newText.trim()) {\n248:         t.text = newText.trim()\n249:         save(); render()\n250:       }\n251:     }\n252: \n253:     $('addBtn').addEventListener('click', add)\n254:     input.addEventListener('keydown', e => { if (e.key === 'Enter') add() })\n255: \n256:     document.querySelectorAll('.filters button').forEach(btn => {\n257:       btn.addEventListener('click', () => {\n258:         filter = btn.dataset.filter\n259:         render()\n260:       })\n261:     })\n262: \n263:     $('clearBtn').addEventListener('click', () => {\n264:       todos = todos.filter(t => !t.done)\n265:       save(); render()\n266:     })\n267: \n268:     render()\n269:   </script>\n270: </body>\n271: </html>\n\n(End of file - total 271 lines)\n</content>"
